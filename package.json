{
  "name": "@automattic/radical-pipelines",
  "version": "0.6.0",
  "private": true,
  "description": "Radical Pipelines Pi package — installable from this repository via git source (pi install git:github.com/Automattic/radical-pipelines) or local path (pi install . -l).",
  "keywords": [
    "pi-package",
    "radical-pipelines"
  ],
  "type": "module",
  "scripts": {
    "release:version": "changeset version && node scripts/sync-version.mjs && npm install --package-lock-only --no-audit --no-fund",
    "test": "node --test 'scripts/test/**/*.test.mjs'"
  },
  "dependencies": {
    "@pi-agents/loop": "^0.3.1",
    "@sinclair/typebox": "^0.34.49",
    "pi-teams": "^0.9.14"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "node_modules/pi-teams/extensions/index.ts",
      "node_modules/@pi-agents/loop/dist/index.js"
    ],
    "skills": [
      "skills",
      "node_modules/pi-teams/skills",
      "node_modules/@pi-agents/loop/skills"
    ],
    "themes": []
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0"
  }
}
